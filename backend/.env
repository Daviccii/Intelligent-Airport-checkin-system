# SMTP Configuration (optional; if not set, codes are generated but not emailed)
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USE_SSL=true
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-app-password
#   SMTP_FROM=SmartFly <youraddress@gmail.com>
# Office 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=true
#   SMTP_USER=youraddress@yourdomain.com
#   SMTP_PASS=your-password
#   SMTP_FROM=SmartFly <youraddress@yourdomain.com>

SMTP_HOST=
SMTP_PORT=
SMTP_USE_SSL=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartFly <noreply@smartfly.example.com>