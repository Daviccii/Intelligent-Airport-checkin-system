# ============================================
# M-PESA INTEGRATION CONFIGURATION
# ============================================

# M-Pesa Daraja API Credentials
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_ENVIRONMENT=sandbox  # sandbox or production

# M-Pesa Shortcodes
MPESA_SHORTCODE=174379  # Test shortcode for sandbox
MPESA_HEAD_OFFICE=174379
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PAYBILL_NUMBER=174379

# M-Pesa B2C Configuration
MPESA_INITIATOR_USERNAME=your_initiator_username
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_SECURITY_CREDENTIAL=your_security_credential_base64

# M-Pesa Callback URLs
MPESA_QUEUE_TIMEOUT_URL=https://yourdomain.com/api/mpesa/queue-timeout
MPESA_B2C_RESULT_URL=https://yourdomain.com/api/mpesa/b2c-result

# ============================================
# SMS INTEGRATION CONFIGURATION
# ============================================

# SMS Provider (africastalking, twilio, safaricom)
SMS_PROVIDER=africastalking

# Africa's Talking Credentials
SMS_API_KEY=your_africastalking_api_key
SMS_USERNAME=your_africastalking_username
SMS_SENDER_ID=SmartFly

# Twilio Credentials (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+254700000000

# ============================================
# EMAIL INTEGRATION CONFIGURATION
# ============================================

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=noreply@smartfly.com
FROM_NAME=SmartFly Airlines

# ============================================
# EXISTING CONFIGURATION
# ============================================

# Database (if using)
DATABASE_URL=sqlite:///smartfly.db

# Redis (if using RQ for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here